NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://oms:oms_secret@localhost:5432/oms
ADMIN_PASSWORD=12345
ENCRYPTION_KEY=dev-encryption-key-change-me-32b
# Include Docker frontend origin when using compose (http://localhost:3000)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Production default: false. Set true only for local empty channel stubs (no seeded demo products/orders).
MOCK_CHANNELS=false
SYNC_CRON=*/5 * * * *
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
SIMULATION_MODE=true
