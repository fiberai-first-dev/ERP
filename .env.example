# Copy to .env in this folder. Docker Compose reads it automatically.
# Never commit .env

# --- Shared ---
POSTGRES_USER=oms
POSTGRES_PASSWORD=oms_secret
POSTGRES_DB=oms
ADMIN_PASSWORD=12345
ENCRYPTION_KEY=dev-encryption-key-change-me-32b
LOG_LEVEL=info
SYNC_CRON=*/5 * * * *
MOCK_CHANNELS=false
SIMULATION_MODE=true

# --- Local (`docker compose up --build`) ---
# Leave VITE_API_BASE_URL empty so the UI talks to the same origin (/api via nginx).
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://erp-demo.fybud.com
VITE_API_BASE_URL=

# --- Production (`./scripts/enable-prod.sh`) ---
# Point DNS:
#   erp-demo.fybud.com      → this server
#   api.erp-demo.fybud.com  → this server
# NODE_ENV=production
# ADMIN_PASSWORD=change-me
# ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-chars
# POSTGRES_PASSWORD=replace-with-a-strong-db-password
# CORS_ORIGIN=https://erp-demo.fybud.com
# VITE_API_BASE_URL=https://api.erp-demo.fybud.com
# ACME_EMAIL=admin@fybud.com
